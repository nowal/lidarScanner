# ---------------------------------------------------------------- service
LIDARAI_HOST=0.0.0.0
LIDARAI_PORT=8000
LIDARAI_STORAGE_DIR=./backend_storage
# REQUIRED in production: with this unset, every homeowner endpoint
# (including paid model calls) is served unauthenticated.
LIDARAI_AUTH_TOKEN=local-dev-token
LIDARAI_CORS_ORIGINS=*
# Refuse to start when acceptance-critical config is missing. Set true on
# the production service; leave unset for local dev and tests.
LIDARAI_STRICT_CONFIG=

# ------------------------------------------------------------ scan pipeline
LIDARAI_JOB_TIMEOUT_SECONDS=1200
LIDARAI_JOB_RETENTION_DAYS=3
LIDARAI_JOB_RETENTION_MAX_JOBS=25
LIDARAI_JOB_RETENTION_MIN_FREE_MB=2048
LIDARAI_JOB_DELETE_TERMINAL_AFTER_SECONDS=3600
LIDARAI_DEFAULT_PROCESSING_PROFILE=fast_onboarding
LIDARAI_TEXTURE_WORKERS=auto

# ------------------------------------------------------------ model provider
# Beta configuration of record: Anthropic claude-sonnet-5 at effort "low"
# (benchmarked Aug 26 2026 — matches "medium" on all flow-quality checks at
# ~30% lower latency). The OpenAI path remains fully supported; set
# LIDARAI_AI_PROVIDER=openai and the LIDARAI_OPENAI_* block instead.
LIDARAI_AI_PROVIDER=anthropic
LIDARAI_ANTHROPIC_API_KEY=
LIDARAI_ANTHROPIC_MODEL=claude-sonnet-5
LIDARAI_ANTHROPIC_EFFORT=low
LIDARAI_ANTHROPIC_REQUEST_TIMEOUT_SECONDS=60
LIDARAI_ANTHROPIC_MAX_TOKENS=8192

LIDARAI_OPENAI_API_KEY=
LIDARAI_OPENAI_ORGANIZATION=
LIDARAI_OPENAI_PROJECT=
LIDARAI_OPENAI_MODEL=gpt-5.5
LIDARAI_OPENAI_FALLBACK_MODEL=
LIDARAI_OPENAI_REASONING_EFFORT=medium
LIDARAI_OPENAI_REQUEST_TIMEOUT_SECONDS=45
LIDARAI_OPENAI_MAX_IMAGES_PER_REQUEST=1

# ------------------------------------------------------- flow agent (SOW §2)
# Signs the client-echoed flow-state token. REQUIRED in production: without
# it the service falls back to the auth token, and with both unset a
# per-process random secret is used (tokens then die with each restart).
LIDARAI_FLOW_TOKEN_SECRET=
# The opening turn (steps 1-2) may attach more keyframe images.
LIDARAI_OPENING_MAX_IMAGES=4

# ------------------------------------------- persistence (SOW §4 logging)
# The durable home of flow state, the wording journal, and quote requests.
# Unset = local JSONL only, which an ephemeral-disk deploy loses on every
# restart — the SOW §4 logging deliverable requires these set in production.
# Apply backend/supabase/migrations/20260826_flow_agent_persistence.sql to
# the SAME project first (scripts/apply_supabase_migrations.py).
LIDARAI_SUPABASE_URL=
LIDARAI_SUPABASE_SERVICE_ROLE_KEY=
# Verifies X-Homeowner-Token (Supabase legacy HS256 JWT secret).
LIDARAI_SUPABASE_JWT_SECRET=
# Management API — used only by scripts/apply_supabase_migrations.py and
# scripts/retention_purge.py.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# ------------------------------------------------- operations (steps 9-10)
# REQUIRED for the ops API: unset = the ops surface answers 503 and lead
# packages are only stored, never listable by operations.
LIDARAI_OPS_TOKEN=
# Optional webhook that receives each submitted lead package (Zapier ->
# email, Slack, ...). Failure never blocks the homeowner.
LIDARAI_OPS_WEBHOOK_URL=
# Lead email to operations (docs/OPS_GUIDE.md). Resend is the transport
# that works from a PaaS host; the From address needs a verified domain.
LIDARAI_OPS_EMAIL=
LIDARAI_RESEND_API_KEY=
LIDARAI_OPS_EMAIL_FROM=
# Public origin of this service (no trailing slash) -- the signed
# quote-entry link in the email is built from it.
LIDARAI_PUBLIC_BASE_URL=
# Reply-by-email quote entry (optional; IMAP creds fall back to SMTP ones).
LIDARAI_OPS_REPLY_ENABLED=
# Where replies should land. Empty = the ops address itself. Point it at a
# mailbox the poller can read when the ops address cannot be polled (e.g. a
# Workspace account with no app password).
LIDARAI_OPS_REPLY_TO=
# Extra addresses a reply may come from (comma-separated); the ops address
# always counts.
LIDARAI_OPS_REPLY_SENDERS=

# -------------------------------------------- scan gate flag (docs/SCAN_SCOPE.md)
# processor_job (default) | device_bake -- which flag means "the first
# scan's processing is complete" for the SOW §3 gate.
LIDARAI_SCAN_COMPLETE_SIGNAL=device_bake

# --------------------------------- provider discovery + ranking (docs/adr/provider-ranking.md)
# Discovery is off until TakeShape supplies a Google Places key from its own
# account; the provider table and the ranking run either way. Ranking
# weights are LIDARAI_RANK_* (defaults in app/config.py, reference in CONFIG.md).
LIDARAI_PROVIDER_DISCOVERY_ENABLED=
LIDARAI_GOOGLE_PLACES_API_KEY=
# Deprecated: restores the pre-ranking partners-first email ordering.
LIDARAI_PREFERRED_PARTNER_ORDERING_ENABLED=

# --------------------------------------------- research / demo layer flags
# ALL default off. The delivery build ships with every one unset; only the
# internal demo image (Dockerfile.demo) opts in.
LIDARAI_AGENT_PRICE_GUIDANCE_ENABLED=
LIDARAI_PRICE_RESEARCH_ENABLED=
LIDARAI_LOCAL_CONTEXT_ENABLED=
LIDARAI_LOCAL_PROVIDER_RESEARCH_ENABLED=
# LIDARAI_DEMO_ENABLED / LIDARAI_DEMO_PASSWORD: never set on production.

# ----------------------------------------------------- logging (SOW §12)
LIDARAI_LOG_PII_MASKING_ENABLED=true
LIDARAI_LOG_RETENTION_DAYS=90
# Unmasked raw turn log — debugging only, off unless a task requires it.
LIDARAI_RAW_TURN_LOG_ENABLED=
