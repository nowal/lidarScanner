    "required": {
      "schemaVersion": "string",
      "threadId": "string",
      "message": "object",
      "state": "object",
      "suggestedReplies": "array<string>",
      "model": "string",
      "provider": "string",
      "usedFallback": "boolean"
    },
    "optional": {
      "quoteDraft": "object",
      "visualFocus": "object"
    }
  },
  "message": {
    "required": {
      "id": "string",
      "role": "string",
      "content": "string",
      "createdAt": "string",
      "attachments": "array"
    }
  },
  "state": {
    "required": {
      "intent": "enum:intent",
      "quoteStatus": "string",
      "requiresExplicitApproval": "boolean",
      "confidence": "string"
    },
    "optional": {
      "suggestedServiceType": "string"
    }
  },
  "quoteDraft": {
